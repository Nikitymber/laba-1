terms = pd.to_numeric(df_dpu_life_net["срок"], errors="raise")
days = pd.to_numeric(liabilities_result["Кол-во дней"], errors="coerce")
currency = liabilities_result["Валюта"].astype("string").str.strip().str.upper()

target = (
    liabilities_result["Линия бизнеса"].astype("string").str.strip().eq("Остальное")
    & liabilities_result["Активы/Пассивы"].astype("string").str.strip().eq("Пассивы")
)

liabilities_result["ДПУ"] = 0.0

for code in ["RUB", "EUR", "USD", "CNY"]:
    rows = target & currency.eq(code) & days.notna()
    bucket_days = days.loc[rows]
    if bucket_days.empty:
        continue

    # Интервалы заканчиваются на значениях «Кол-во дней» для этой валюты
    upper_bounds = sorted(bucket_days.unique())
    bucket = pd.cut(
        terms,
        bins=[float("-inf"), *upper_bounds],
        labels=upper_bounds,
        right=True,
    )

    # Складываем ДПУ по валюте и записываем итог в строку верхней границы
    totals = df_dpu_life_net[code].groupby(bucket, observed=True).sum()
    values = bucket_days.map(totals).fillna(0)

    # Если граница повторяется, записываем сумму только в первую подходящую строку
    values = values.mask(bucket_days.duplicated(), 0)
    liabilities_result.loc[rows, "ДПУ"] = values.to_numpy()
