import pandas as pd

frames = [df_common.loc[:, columns_to_keep]]

with pd.ExcelFile(file_path, engine="openpyxl") as excel:
    sheets_42204 = [name for name in excel.sheet_names if "42204" in name]

    for name in sheets_42204:
        ws = excel.book[name]

        if ws["B3"].value == "№":
            header_row = 3
        elif ws["B11"].value == "№":
            header_row = 11
        else:
            raise ValueError(f"На листе {name!r} в B3 и B11 отсутствует «№»")

        # Читаем с колонки B и оставляем строки с заполненным номером
        df = excel.parse(name, header=header_row - 1).iloc[:, 1:]
        number = df["№"].astype("string").str.strip().fillna("")
        df = df.loc[number.ne("")].copy()

        df["Валюта"] = name.rsplit("_", 1)[-1]
        df["Линия бизнеса"] = "42204"

        missing = [col for col in columns_to_keep if col not in df.columns]
        if missing:
            raise KeyError(
                f"Лист {name!r}, строка заголовков {header_row}. "
                f"Отсутствуют колонки {missing!r}"
            )

        frames.append(df.loc[:, columns_to_keep])

df_common = pd.concat(frames, ignore_index=True)
