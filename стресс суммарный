        try:
            report_date = pd.to_datetime(match.group(1), format="%Y-%m-%d")
            df = pd.read_excel(
                file_path,
                sheet_name=sheet_name,
                header=header,
                usecols=COLUMNS,
                dtype={"ISIN": "string"},
            )
        except ValueError as error:
            raise ValueError(f"Файл «{file_path.name}» — {error}") from error

        df["Дата"] = report_date
        frames.append(df)

    if not frames:
        raise FileNotFoundError(f"В папке «{folder}» нет файлов ПредДСЖ-yyyy-mm-dd.xlsx")

    return pd.concat(frames, ignore_index=True)[COLUMNS + ["Дата"]]


def aggregate_pred_dszh(df_result):
    """Сложить стоимость и стресс-сценарии по дате, эмитенту и типу ФВ."""
    data = df_result[GROUP_COLUMNS + VALUE_COLUMNS].copy()
    data[VALUE_COLUMNS] = data[VALUE_COLUMNS].apply(pd.to_numeric)

    grouped = data.groupby(
        GROUP_COLUMNS, as_index=False, dropna=False, observed=True
    )
    return grouped[VALUE_COLUMNS].sum(min_count=1)


def save_pred_dszh_excel(df_agg, folder, *, df_result=None):
    """Сохранить сводку и переданную детализацию в одну книгу Excel."""
    output_path = Path(folder) / "ПредДСЖ_агрегация.xlsx"

    with TemporaryDirectory(dir=output_path.parent) as temp_folder:
        temp_path = Path(temp_folder) / output_path.name
        with pd.ExcelWriter(temp_path, engine="openpyxl") as writer:
            df_agg.to_excel(writer, sheet_name="Агрегация", index=False)
            if df_result is not None:
                df_result.to_excel(writer, sheet_name="Детализация", index=False)
        temp_path.replace(output_path)

    return output_path


