"""Чтение файлов ПредДСЖ и расчёт итогов по эмитентам."""

import argparse
import re
from pathlib import Path

import pandas as pd


FILE_PATTERN = re.compile(r"ПредДСЖ-([0-9]{4}-[0-9]{2}-[0-9]{2})\.(?i:xlsx)")
ISSUER_COLUMN = "Наименование эмитента"
ASSET_TYPE_COLUMN = "Тип ФВ(акция/облигация/депозит и т.д.)"
GROUP_COLUMNS = ["Дата", ISSUER_COLUMN, ASSET_TYPE_COLUMN]
VALUE_COLUMNS = [
    "fair_value",
    "Умеренный стресс 1",
    "Пессимистичный стресс 2",
]
COLUMNS = [ISSUER_COLUMN, "ISIN", ASSET_TYPE_COLUMN, *VALUE_COLUMNS]


def read_pred_dszh(folder, sheet_name=0, header=0):
    """Вернуть общую таблицу с датой отчёта из имени каждого файла."""
    folder = Path(folder)
    frames = []

    for file_path in sorted(folder.iterdir()):
        match = FILE_PATTERN.fullmatch(file_path.name)
        if match is None or not file_path.is_file():
            continue

        try:
            report_date = pd.to_datetime(match.group(1), format="%Y-%m-%d")
            df = pd.read_excel(
                file_path,
                sheet_name=sheet_name,
                header=header,
                usecols=COLUMNS,
                dtype={"ISIN": "string"},
            )
        except ValueError as error:
            raise ValueError(f"Файл «{file_path.name}» — {error}") from error

        df["Дата"] = report_date
        frames.append(df)

    if not frames:
        raise FileNotFoundError(f"В папке «{folder}» нет файлов ПредДСЖ-yyyy-mm-dd.xlsx")

    return pd.concat(frames, ignore_index=True)[COLUMNS + ["Дата"]]


def aggregate_pred_dszh(df_result):
    """Сложить стоимость и стресс-сценарии по дате, эмитенту и типу ФВ."""
    data = df_result[GROUP_COLUMNS + VALUE_COLUMNS].copy()
    data[VALUE_COLUMNS] = data[VALUE_COLUMNS].apply(pd.to_numeric)

    grouped = data.groupby(
        GROUP_COLUMNS, as_index=False, dropna=False, observed=True
    )
    return grouped[VALUE_COLUMNS].sum(min_count=1)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "folder",
        nargs="?",
        type=Path,
        default=Path(__file__).resolve().parent,
        help="папка с Excel-файлами (по умолчанию папка со скриптом)",
    )
    df_result = read_pred_dszh(parser.parse_args().folder)
    print(df_result.head().to_string(index=False))
    print(f"Всего строк — {len(df_result)}")

    df_agg = aggregate_pred_dszh(df_result)
    print()
    print("Сводка по дате, эмитенту и типу ФВ")
    print(df_agg.head().to_string(index=False))
    print(f"Всего групп — {len(df_agg)}")
