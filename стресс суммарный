"""Чтение файлов ПредДСЖ и выгрузка итогов по эмитентам в Excel."""

import argparse
import re
from pathlib import Path
from tempfile import TemporaryDirectory

import pandas as pd


FILE_PATTERN = re.compile(r"ПредДСЖ-([0-9]{4}-[0-9]{2}-[0-9]{2})\.(?i:xlsx)")
ISSUER_COLUMN = "Наименование эмитента"
ASSET_TYPE_COLUMN = "Тип ФВ(акция/облигация/депозит и т.д.)"
GROUP_COLUMNS = ["Дата", ISSUER_COLUMN, ASSET_TYPE_COLUMN]
STRESS_COLUMNS = [
    "Умеренный стресс 1",
    "Пессимистичный стресс 2",
]
VALUE_COLUMNS = ["fair_value", *STRESS_COLUMNS]
COLUMNS = [ISSUER_COLUMN, "ISIN", ASSET_TYPE_COLUMN, *VALUE_COLUMNS]
STRESS_ASSET_TYPES = {
    "Облигации": ("облигация", "облигации"),
    "Акции": ("акция", "акции"),
}


def read_pred_dszh(folder, sheet_name=0, header=0):
    """Вернуть общую таблицу с датой отчёта из имени каждого файла."""
    folder = Path(folder)
    frames = []

    for file_path in sorted(folder.iterdir()):
        match = FILE_PATTERN.fullmatch(file_path.name)
        if match is None or not file_path.is_file():
            continue

        try:
            report_date = pd.to_datetime(match.group(1), format="%Y-%m-%d")
            df = pd.read_excel(
                file_path,
                sheet_name=sheet_name,
                header=header,
                usecols=COLUMNS,
                dtype={"ISIN": "string"},
            )
        except ValueError as error:
            raise ValueError(f"Файл «{file_path.name}» — {error}") from error

        df["Дата"] = report_date
        frames.append(df)

    if not frames:
        raise FileNotFoundError(f"В папке «{folder}» нет файлов ПредДСЖ-yyyy-mm-dd.xlsx")

    return pd.concat(frames, ignore_index=True)[COLUMNS + ["Дата"]]


def aggregate_pred_dszh(df_result):
    """Сложить стоимость и стресс-сценарии по дате, эмитенту и типу ФВ."""
    data = df_result[GROUP_COLUMNS + VALUE_COLUMNS].copy()
    data[VALUE_COLUMNS] = data[VALUE_COLUMNS].apply(pd.to_numeric)

    grouped = data.groupby(
        GROUP_COLUMNS, as_index=False, dropna=False, observed=True
    )
    return grouped[VALUE_COLUMNS].sum(min_count=1)


def summarize_stress_by_asset_type(df_agg):
    """Рассчитать среднее и выборочное СКО дневных сумм по эмитентам."""
    asset_types = df_agg[ASSET_TYPE_COLUMN].astype("string").str.strip().str.casefold()
    statistics = {
        f"{column} — {label}": (column, method)
        for column in STRESS_COLUMNS
        for label, method in (("среднее", "mean"), ("СКО", "std"))
    }

    summaries = {}
    for sheet_name, type_names in STRESS_ASSET_TYPES.items():
        rows = df_agg.loc[asset_types.isin(type_names)]
        daily_groups = rows.groupby(
            ["Дата", ISSUER_COLUMN], as_index=False, dropna=False, observed=True
        )
        daily_stress = daily_groups[STRESS_COLUMNS].sum(min_count=1)
        issuer_groups = daily_stress.groupby(
            ISSUER_COLUMN, as_index=False, dropna=False, observed=True
        )
        summaries[sheet_name] = issuer_groups.agg(**statistics)

    return summaries


def save_pred_dszh_excel(df_agg, folder, *, df_result=None):
    """Сохранить агрегацию, статистику стрессов и переданную детализацию."""
    output_path = Path(folder) / "ПредДСЖ_агрегация.xlsx"
    stress_summaries = summarize_stress_by_asset_type(df_agg)

    with TemporaryDirectory(dir=output_path.parent) as temp_folder:
        temp_path = Path(temp_folder) / output_path.name
        with pd.ExcelWriter(temp_path, engine="openpyxl") as writer:
            df_agg.to_excel(writer, sheet_name="Агрегация", index=False)
            if df_result is not None:
                df_result.to_excel(writer, sheet_name="Детализация", index=False)
            for sheet_name, summary in stress_summaries.items():
                summary.to_excel(writer, sheet_name=sheet_name, index=False)
        temp_path.replace(output_path)

    return output_path


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "folder",
        nargs="?",
        type=Path,
        default=Path(__file__).resolve().parent,
        help="папка с Excel-файлами (по умолчанию папка со скриптом)",
    )
    folder = parser.parse_args().folder
    df_result = read_pred_dszh(folder)
    print(df_result.head().to_string(index=False))
    print(f"Всего строк — {len(df_result)}")

    df_agg = aggregate_pred_dszh(df_result)
    output_path = save_pred_dszh_excel(df_agg, folder, df_result=df_result)
    print()
    print("Сводка по дате, эмитенту и типу ФВ")
